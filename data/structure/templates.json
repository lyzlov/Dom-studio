{
  "$комментарий": "Шаблоны страниц-сущностей. Двенадцать страниц курсов описаны здесь одной записью: правка шаблона меняет все двенадцать.",
  "курс": {
    "раздел": "Курсы",
    "родитель": "html/courses/courses.html",
    "title": "{название} — курсы ДОМ",
    "description": "{название}. Возраст: {возраст}.",
    "надзаголовок": "{направление}",
    "поля": ["возраст", "время", "куратор", "оплата"],
    "кнопка": "всегда",
    "блоки": [
      { "тип": "текст", "id": "format", "текст": "content/courses/{id}.html" }
    ]
  },
  "событие": {
    "раздел": "События",
    "родитель": "html/events/events.html",
    "title": "{название} — события ДОМ",
    "description": "{название}. {дата}.",
    "надзаголовок": "{тип}",
    "поля": ["дата", "время и возраст", "место", "кураторы", "цена"],
    "кнопка": "пока не прошло",
    "блоки": [
      { "тип": "текст", "текст": "content/events/{id}.html" }
    ]
  },
  "смена": {
    "раздел": "Летний лагерь",
    "родитель": "html/camp/camp.html",
    "title": "{название} — Летний лагерь ДОМ",
    "description": "{описание}",
    "надзаголовок": "Летний лагерь {год} · {тип}",
    "поля": ["даты", "возраст", "место", "куратор", "цена"],
    "кнопка": "пока не прошло",
    "блоки": [
      { "тип": "текст", "текст": "content/camp/{id}.html" },
      { "тип": "таблица", "id": "schedule", "заголовок": "Распорядок дня", "вид": "простая", "источник": "camp.распорядок" }
    ]
  }
}
