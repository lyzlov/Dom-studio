{
  "$comment": "How the site's elements are built: what each type consists of and which fields describe it. No human-language names live here — those are in _lang/<language>/types.json. The build fails if a type is declared here and not implemented in code, or the other way round.",
  "blockTypes": {
    "$comment": "What a block can be filled with. A block is a heading plus exactly one filling. The list is closed.",
    "text": {
      "fields": {
        "heading": "string?",
        "text": "path: _data/text/"
      }
    },
    "cards": {
      "fields": {
        "heading": "string?",
        "source": "catalog",
        "kind": "course | event | session | post | service | university",
        "filter": "rule?",
        "filters": "list?",
        "wide": "bool"
      }
    },
    "team": {
      "fields": {
        "heading": "string?",
        "source": "team"
      }
    },
    "table": {
      "fields": {
        "heading": "string?",
        "kind": "schedule | plain",
        "source": "catalog"
      }
    },
    "gallery": {
      "fields": {
        "source": "frames",
        "mode": "strip | grid"
      }
    },
    "faq": {
      "fields": {
        "heading": "string?",
        "source": "faq"
      }
    },
    "rating": {
      "fields": {
        "heading": "string?",
        "source": "site.reviews"
      }
    },
    "links": {
      "fields": {
        "items": "list: name, href"
      }
    },
    "contacts": {
      "fields": {
        "heading": "string?",
        "map": "bool"
      }
    },
    "form": {
      "fields": {
        "heading": "string?"
      }
    },
    "tabs": {
      "fields": {
        "tabs": "list: key, name, blocks",
        "action": "icon?"
      }
    },
    "hero": {
      "named": false,
      "fields": {
        "slogan": "string",
        "facts": "string",
        "banner": "banner"
      },
      "parts": {
        "button": {
          "opens": "form",
          "word": "ui.enroll"
        }
      }
    }
  },
  "pageElements": {
    "$comment": "Page-level elements, outside the list of blocks.",
    "section-head": {
      "fields": {
        "eyebrow": "string",
        "h1": "string",
        "fields": "list: caption, value",
        "button": "bool",
        "gallery": "frames"
      },
      "parts": {
        "button": {
          "opens": "form",
          "word": "ui.enroll"
        }
      }
    },
    "header": {
      "parts": {
        "logo": {
          "href": "index.html",
          "media": "_assets/brand/logo-dark.svg",
          "template": "header-logo"
        },
        "menu": {
          "data": "structure.navigation.menu",
          "template": "header-menu"
        },
        "social": {
          "data": "site.contacts.social",
          "template": "header-social"
        }
      }
    },
    "footer": {
      "parts": {
        "brand": {
          "media": "_assets/brand/logo.svg",
          "data": "site.org",
          "fields": [
            "slogan"
          ],
          "zone": "grid",
          "template": "footer-brand"
        },
        "contacts": {
          "data": "site.contacts",
          "zone": "grid",
          "template": "footer-contacts"
        },
        "sections": {
          "data": "structure.navigation.footer",
          "zone": "grid",
          "template": "footer-sections"
        },
        "legal": {
          "data": "site.org",
          "fields": [
            "fullName",
            "legalEntity",
            "inn",
            "ogrn",
            "legalAddress"
          ],
          "zone": "row",
          "template": "footer-legal"
        }
      }
    }
  },
  "banner": {
    "$comment": "Contents of the hero banner. The link to a record is stated but not binding: any field can be overridden.",
    "source": "nearest | catalog | none",
    "id": "id?",
    "overrides": [
      "heading",
      "date",
      "caption",
      "link"
    ]
  },
  "entities": {
    "$comment": "Things that have both a card and a page of their own. The identifier gives both the folder name and the address. The field list is what the editor's form shows.",
    "course": {
      "data": "catalog.courses",
      "media": "courses",
      "folder": "courses",
      "template": "course",
      "fields": [
        "title",
        "id",
        "direction",
        "age",
        "curator",
        "plan",
        "lessons",
        "cover",
        "gallery",
        "text"
      ],
      "refs": {
        "direction": "direction",
        "plan": "plan",
        "room": "room"
      },
      "options": {
        "curator": {
          "kind": "teacher",
          "field": "id",
          "caption": "name"
        }
      }
    },
    "event": {
      "data": "catalog.events",
      "media": "events",
      "folder": "events",
      "template": "event",
      "fields": [
        "title",
        "id",
        "type",
        "date",
        "place",
        "age",
        "curators",
        "price",
        "description",
        "cover",
        "gallery",
        "text"
      ],
      "refs": {
        "type": "event-kind"
      },
      "options": {
        "place": {
          "kind": "event",
          "field": "place"
        }
      }
    },
    "session": {
      "data": "catalog.camp.sessions",
      "media": "camp",
      "folder": "camp",
      "template": "session",
      "fields": [
        "title",
        "id",
        "type",
        "dates",
        "age",
        "place",
        "curator",
        "price",
        "description",
        "cover",
        "gallery",
        "text"
      ],
      "refs": {
        "type": "session-kind"
      },
      "options": {
        "curator": {
          "kind": "teacher",
          "field": "id",
          "caption": "name"
        },
        "place": {
          "kind": "session",
          "field": "place"
        }
      }
    },
    "post": {
      "data": "catalog.blog",
      "media": "blog",
      "folder": "blog",
      "template": "post",
      "fields": [
        "heading",
        "id",
        "date",
        "readTime",
        "cover",
        "text"
      ]
    }
  },
  "records": {
    "$comment": "Things that live only as a card or a row: they have no page of their own.",
    "service": {
      "data": "catalog.services",
      "fields": [
        "title",
        "description"
      ]
    },
    "university": {
      "data": "catalog.universities",
      "fields": [
        "title",
        "subheading",
        "description",
        "note"
      ]
    },
    "teacher": {
      "data": "catalog.team",
      "media": "team",
      "fields": [
        "id",
        "name",
        "role",
        "bio"
      ]
    },
    "question": {
      "data": "catalog.faq",
      "fields": [
        "question",
        "answer"
      ]
    }
  },
  "dictionaries": {
    "$comment": "Closed lists of values: no card, no page, but fields refer to them. The name is edited; the reference goes by address.",
    "direction": {
      "data": "site.directions",
      "fields": [
        "title"
      ]
    },
    "plan": {
      "data": "catalog.prices.plans",
      "fields": [
        "title",
        "tableLabel",
        "trial",
        "single",
        "packages"
      ]
    },
    "room": {
      "data": "site.rooms",
      "fields": [
        "title"
      ]
    },
    "event-kind": {
      "data": "site.eventKinds",
      "fields": [
        "title"
      ]
    },
    "session-kind": {
      "data": "site.sessionKinds",
      "fields": [
        "title"
      ]
    }
  },
  "sources": {
    "$comment": "What a block can show besides the catalogs.",
    "site.gallery": true,
    "camp.routine": true,
    "nearest": true,
    "none": true
  },
  "rows": {
    "$comment": "What a list row consists of. Needed so an empty list still shows its columns and a new row appears with the right fields rather than blank.",
    "lessons": [
      "day",
      "time",
      "age",
      "room"
    ],
    "sessions": [
      "title",
      "id",
      "type",
      "dates",
      "age",
      "place",
      "curator",
      "price",
      "description"
    ],
    "footer": [
      "name",
      "href"
    ],
    "items": [
      "name",
      "href"
    ],
    "path": [
      "name",
      "href"
    ],
    "social": [
      "name",
      "icon",
      "label",
      "href"
    ],
    "gallery": [
      "base",
      "caption"
    ],
    "packages": [
      "title",
      "price",
      "tableLabel"
    ],
    "fields": [
      "key",
      "name",
      "caption",
      "type",
      "required"
    ],
    "directions": [
      "id",
      "title"
    ],
    "rooms": [
      "id",
      "title"
    ],
    "eventKinds": [
      "id",
      "title"
    ],
    "sessionKinds": [
      "id",
      "title"
    ],
    "date": [
      "from",
      "to",
      "time"
    ],
    "dates": [
      "from",
      "to",
      "time"
    ]
  },
  "mediaFolders": {
    "$comment": "How the media folders are named for a person. The latin folder names are never shown.",
    "courses": true,
    "events": true,
    "camp": true,
    "team": true,
    "space": true
  },
  "formats": {
    "$comment": "How a field is shown to a person. Stored machine-readable — a date as 2026-02-20 — but entered and displayed the local way: 20.02.2026. The date caption is assembled from month names, which live in the words file.",
    "from": "date",
    "to": "date",
    "time": "time"
  },
  "overlayElements": {
    "$comment": "Elements on top of the page: shown on an action rather than in the flow. Their markup is their own; their data is shared across the site.",
    "form": {
      "data": "structure.form.fields",
      "template": "form"
    }
  },
  "captions": {
    "$comment": "Fields that hold words, listed per data file. The words move to _lang/<language>/<file>.json; the structure stays here. The same field name means different things in different files: name in the form is a machine field name, in the breadcrumbs it is a caption.",
    "pages": [
      "metaTitle",
      "metaDescription",
      "eyebrow",
      "h1",
      "heading",
      "subheading",
      "slogan",
      "facts",
      "meta",
      "caption",
      "collapsed",
      "name",
      "lead",
      "paragraphs"
    ],
    "templates": [
      "metaTitle",
      "metaDescription",
      "eyebrow",
      "heading",
      "section",
      "fields"
    ],
    "navigation": [
      "group"
    ],
    "form": [
      "caption"
    ]
  }
}
