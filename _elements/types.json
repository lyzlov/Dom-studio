{
  "$комментарий": "Устройство элементов сайта: из чего состоит каждый тип и какими полями описывается. Имён на человеческом языке здесь нет — они в _elements/names.<язык>.json. Сборка падает, если тип объявлен здесь и не реализован в коде или наоборот.",
  "blockTypes": {
    "$комментарий": "Чем наполняется блок. Блок = заголовок + одно наполнение. Список закрыт.",
    "text": {
      "fields": {
        "heading": "string?",
        "text": "path: _content/text/"
      }
    },
    "cards": {
      "fields": {
        "heading": "string?",
        "source": "catalog",
        "kind": "course | event | session | post | service | university",
        "filter": "rule?",
        "filters": "list?",
        "wide": "bool"
      }
    },
    "team": {
      "fields": {
        "heading": "string?",
        "source": "team"
      }
    },
    "table": {
      "fields": {
        "heading": "string?",
        "kind": "schedule | plain",
        "source": "catalog"
      }
    },
    "gallery": {
      "fields": {
        "source": "frames",
        "mode": "strip | grid"
      }
    },
    "faq": {
      "fields": {
        "heading": "string?",
        "source": "faq"
      }
    },
    "rating": {
      "fields": {
        "heading": "string?",
        "source": "site.reviews"
      }
    },
    "links": {
      "fields": {
        "items": "list: name, href"
      }
    },
    "contacts": {
      "fields": {
        "heading": "string?",
        "map": "bool"
      }
    },
    "form": {
      "fields": {
        "heading": "string?"
      }
    },
    "tabs": {
      "fields": {
        "tabs": "list: key, name, blocks",
        "action": "icon?"
      }
    },
    "hero": {
      "named": false,
      "fields": {
        "slogan": "string",
        "facts": "string",
        "banner": "banner"
      },
      "parts": {
        "button": {
          "opens": "form"
        }
      }
    }
  },
  "pageElements": {
    "$комментарий": "Элементы уровня страницы, вне списка блоков.",
    "section-head": {
      "fields": {
        "eyebrow": "string",
        "h1": "string",
        "fields": "list: caption, value",
        "button": "bool",
        "gallery": "frames"
      },
      "parts": {
        "button": {
          "opens": "form"
        }
      }
    },
    "header": {
      "parts": {
        "logo": {
          "href": "index.html",
          "media": "_theme/brand/logo-dark.svg",
          "template": "header-logo"
        },
        "menu": {
          "data": "structure.navigation.menu",
          "template": "header-menu"
        },
        "social": {
          "data": "site.contacts.social",
          "template": "header-social"
        }
      }
    },
    "footer": {
      "parts": {
        "brand": {
          "media": "_theme/brand/logo.svg",
          "data": "site.org",
          "fields": [
            "slogan"
          ],
          "zone": "grid",
          "template": "footer-brand"
        },
        "contacts": {
          "data": "site.contacts",
          "zone": "grid",
          "template": "footer-contacts"
        },
        "sections": {
          "data": "structure.navigation.footer",
          "zone": "grid",
          "template": "footer-sections"
        },
        "legal": {
          "data": "site.org",
          "fields": [
            "fullName",
            "legalEntity",
            "inn",
            "ogrn",
            "legalAddress"
          ],
          "zone": "row",
          "template": "footer-legal"
        }
      }
    }
  },
  "banner": {
    "$комментарий": "Содержимое баннера первого экрана. Связь с сущностью указывается, но не диктует: любое поле можно перебить.",
    "source": "nearest | catalog | none",
    "id": "id?",
    "overrides": [
      "heading",
      "date",
      "caption",
      "link"
    ]
  },
  "entities": {
    "$комментарий": "То, у чего есть и карточка, и своя страница. Идентификатор задаёт и имя папки, и адрес. Набор полей — то, что показывает форма редактора.",
    "course": {
      "data": "catalog.courses",
      "media": "courses",
      "folder": "courses",
      "template": "course",
      "fields": [
        "title",
        "id",
        "direction",
        "age",
        "curator",
        "plan",
        "lessons",
        "cover",
        "gallery",
        "text"
      ],
      "refs": {
        "direction": "direction",
        "plan": "plan",
        "room": "room"
      },
      "options": {
        "curator": {
          "kind": "teacher",
          "field": "name"
        },
        "age": {
          "kind": "course",
          "field": "age"
        }
      }
    },
    "event": {
      "data": "catalog.events",
      "media": "events",
      "folder": "events",
      "template": "event",
      "fields": [
        "title",
        "id",
        "type",
        "date",
        "place",
        "age",
        "curators",
        "price",
        "description",
        "cover",
        "gallery",
        "text"
      ],
      "refs": {
        "type": "event-kind"
      },
      "options": {
        "age": {
          "kind": "event",
          "field": "age"
        },
        "place": {
          "kind": "event",
          "field": "place"
        }
      }
    },
    "session": {
      "data": "catalog.camp.sessions",
      "media": "camp",
      "folder": "camp",
      "template": "session",
      "fields": [
        "title",
        "id",
        "type",
        "dates",
        "age",
        "place",
        "curator",
        "price",
        "description",
        "cover",
        "gallery",
        "text"
      ],
      "refs": {
        "type": "session-kind"
      },
      "options": {
        "curator": {
          "kind": "teacher",
          "field": "name"
        },
        "age": {
          "kind": "session",
          "field": "age"
        },
        "place": {
          "kind": "session",
          "field": "place"
        }
      }
    },
    "post": {
      "data": "catalog.blog",
      "media": "blog",
      "folder": "blog",
      "template": "post",
      "fields": [
        "heading",
        "id",
        "date",
        "readTime",
        "cover",
        "text"
      ]
    }
  },
  "records": {
    "$комментарий": "То, что живёт только карточкой или строкой: своей страницы нет.",
    "service": {
      "data": "catalog.services",
      "fields": [
        "title",
        "description"
      ]
    },
    "university": {
      "data": "catalog.universities",
      "fields": [
        "title",
        "subheading",
        "description",
        "note"
      ]
    },
    "teacher": {
      "data": "catalog.team",
      "media": "team",
      "fields": [
        "id",
        "name",
        "role",
        "bio"
      ]
    },
    "question": {
      "data": "catalog.faq",
      "fields": [
        "question",
        "answer"
      ]
    }
  },
  "dictionaries": {
    "$комментарий": "Закрытые списки значений: у них нет ни карточки, ни страницы, но на них ссылаются поля. Правится название, ссылка идёт по адресу.",
    "direction": {
      "data": "site.directions",
      "fields": [
        "title"
      ]
    },
    "plan": {
      "data": "catalog.prices.plans",
      "fields": [
        "title",
        "tableLabel",
        "trial",
        "single",
        "packages"
      ]
    },
    "room": {
      "data": "site.rooms",
      "fields": [
        "title"
      ]
    },
    "event-kind": {
      "data": "site.eventKinds",
      "fields": [
        "title"
      ]
    },
    "session-kind": {
      "data": "site.sessionKinds",
      "fields": [
        "title"
      ]
    }
  },
  "sources": {
    "$комментарий": "Что может показывать блок помимо справочников.",
    "site.gallery": true,
    "camp.routine": true,
    "nearest": true,
    "none": true
  },
  "rows": {
    "$комментарий": "Из чего состоит строка списка. Нужно, чтобы пустой список показывал свои колонки и чтобы новая строка появлялась с нужными полями, а не пустой строкой.",
    "lessons": [
      "day",
      "time",
      "age",
      "room"
    ],
    "sessions": [
      "title",
      "id",
      "type",
      "dates",
      "age",
      "place",
      "curator",
      "price",
      "description"
    ],
    "footer": [
      "name",
      "href"
    ],
    "items": [
      "name",
      "href"
    ],
    "path": [
      "name",
      "href"
    ],
    "social": [
      "name",
      "icon",
      "label",
      "href"
    ],
    "gallery": [
      "base",
      "caption"
    ],
    "packages": [
      "title",
      "price",
      "tableLabel"
    ],
    "fields": [
      "key",
      "name",
      "caption",
      "type",
      "required"
    ],
    "directions": [
      "id",
      "title"
    ],
    "rooms": [
      "id",
      "title"
    ],
    "eventKinds": [
      "id",
      "title"
    ],
    "sessionKinds": [
      "id",
      "title"
    ],
    "date": [
      "from",
      "to",
      "time"
    ],
    "dates": [
      "from",
      "to",
      "time"
    ]
  },
  "mediaFolders": {
    "$комментарий": "Как папки медиатеки называются по-русски. Имена папок латиницей человеку не показываются.",
    "courses": true,
    "events": true,
    "camp": true,
    "team": true,
    "space": true
  },
  "formats": {
    "$комментарий": "Как поле показывается человеку. Хранится машинно — датой вида 2026-02-20, — а вводится и показывается по-нашему: 20.02.2026. Подпись даты собирается из имён месяцев, они лежат в словаре имён.",
    "from": "date",
    "to": "date",
    "time": "time"
  },
  "overlayElements": {
    "$комментарий": "Элементы поверх страницы: показываются по действию, а не в потоке. Разметка у них своя, данные — общие для всего сайта.",
    "form": {
      "data": "structure.form.fields",
      "template": "form"
    }
  },
  "captions": {
    "$комментарий": "Поля со словами — по файлу структуры. Слова уезжают в _structure/captions.<язык>.json, состав остаётся здесь. Одно и то же имя в разных файлах значит разное: name в форме — машинное имя поля, а в крошках — подпись.",
    "pages": [
      "metaTitle",
      "metaDescription",
      "eyebrow",
      "h1",
      "heading",
      "subheading",
      "slogan",
      "facts",
      "meta",
      "caption",
      "collapsed",
      "name",
      "lead"
    ],
    "templates": [
      "metaTitle",
      "metaDescription",
      "eyebrow",
      "heading",
      "section"
    ],
    "navigation": [
      "group"
    ],
    "form": [
      "caption"
    ]
  }
}
