{
  "$comment": "Templates for record pages. Twelve course pages are described here by one entry: editing the template changes all twelve.",
  "course": {
    "parent": "courses/index.html",
    "button": "always",
    "blocks": [
      {
        "type": "text",
        "id": "format",
        "text": "_content/text/courses/{id}.html"
      }
    ],
    "folder": "courses"
  },
  "event": {
    "parent": "events/index.html",
    "button": "until-past",
    "blocks": [
      {
        "type": "text",
        "text": "_content/text/events/{id}.html"
      }
    ],
    "folder": "events"
  },
  "session": {
    "parent": "camp/index.html",
    "button": "until-past",
    "blocks": [
      {
        "type": "text",
        "text": "_content/text/camp/{id}.html"
      },
      {
        "type": "table",
        "id": "schedule",
        "kind": "plain",
        "source": "camp.routine"
      }
    ],
    "folder": "camp"
  },
  "post": {
    "parent": "blog/index.html",
    "folder": "blog",
    "button": "none",
    "meta": "{date} · {readTime}",
    "blocks": [
      {
        "type": "text",
        "text": "_content/text/blog/{id}.html"
      }
    ]
  }
}
