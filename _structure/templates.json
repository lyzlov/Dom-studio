    "eyebrow": "{type}",
    "fields": [
      "дата",
      "время и возраст",
      "место",
      "кураторы",
      "цена"
    ],
    "button": "until-past",
    "blocks": [
      {
        "type": "text",
        "text": "_content/text/events/{id}.html"
      }
    ],
    "folder": "events"
  },
  "session": {
    "section": "Лагерь",
    "parent": "camp/index.html",
    "metaTitle": "{title} — Летний лагерь ДОМ",
    "metaDescription": "{description}",
