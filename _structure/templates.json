{
  "$комментарий": "Шаблоны страниц-сущностей. Двенадцать страниц курсов описаны здесь одной записью: правка шаблона меняет все двенадцать.",
  "курс": {
    "раздел": "Курсы",
    "родитель": "courses/index.html",
    "title": "{название} — курсы ДОМ",
    "description": "{название}. Возраст: {возраст}.",
    "надзаголовок": "{направление}",
    "поля": [
      "возраст",
      "время",
      "куратор",
      "оплата"
    ],
    "кнопка": "всегда",
    "блоки": [
      {
        "тип": "текст",
        "id": "format",
        "текст": "_content/text/courses/{id}.html"
      }
    ],
    "папка": "courses"
  },
  "событие": {
    "раздел": "События",
    "родитель": "events/index.html",
    "title": "{название} — события ДОМ",
    "description": "{название}. {дата}.",
    "надзаголовок": "{тип}",
    "поля": [
      "дата",
      "время и возраст",
      "место",
      "кураторы",
      "цена"
    ],
    "кнопка": "пока не прошло",
    "блоки": [
      {
        "тип": "текст",
        "текст": "_content/text/events/{id}.html"
      }
    ],
    "папка": "events"
  },
  "смена": {
    "раздел": "Лагерь",
    "родитель": "camp/index.html",
    "title": "{название} — Летний лагерь ДОМ",
    "description": "{описание}",
    "надзаголовок": "Летний лагерь {год} · {тип}",
    "поля": [
      "даты",
      "возраст",
      "место",
      "куратор",
      "цена"
    ],
    "кнопка": "пока не прошло",
    "блоки": [
      {
        "тип": "текст",
        "текст": "_content/text/camp/{id}.html"
      },
      {
        "тип": "таблица",
        "id": "schedule",
        "заголовок": "Распорядок дня",
        "вид": "простая",
        "источник": "camp.распорядок"
      }
    ],
    "папка": "camp"
  },
  "пост": {
    "раздел": "Блог",
    "родитель": "blog/index.html",
    "папка": "blog",
    "title": "{заголовок} — блог ДОМ",
    "description": "{заголовок}. {дата}.",
    "надзаголовок": "Блог",
    "поля": [],
    "кнопка": "нет",
    "мета": "{дата} · {чтение}",
    "блоки": [
      {
        "тип": "текст",
        "текст": "_content/text/blog/{id}.html"
      }
    ]
  }
}