{
  "$comment": "The project manifest for the Enfilade editor: where the files live, where to write, how to cut images, how the tokens are grouped. The project is addressed by id; the name shown to a human lives in its words, _lang/<language>/project.json. No project names live in the editor's code.",
  "id": "dom",
  "lang": "ru",
  "contract": 1,
  "files": {
    "site": "_data/site.json",
    "archive": "_data/archive.json",
    "catalog": "_data/catalog/{name}.json",
    "texts": "_lang/{lang}/text/",
    "pages": "_data/pages.json",
    "templates": "_data/templates.json",
    "navigation": "_data/navigation.json",
    "form": "_data/form.json",
    "types": "_code/types.json",
    "markup": "_code/markup.html",
    "tokens": "_assets/tokens.css",
    "settings": "_assets/editor.css",
    "typography": "_lang/{lang}/typography.json",
    "styles": "_assets/style.css",
    "words": "_lang/{lang}/{name}.json"
  },
  "commit": {
    "$comment": "Where a commit goes. The prefix is the path to the site root inside the repository.",
    "targets": [
      {
        "owner": "lyzlov",
        "repo": "Dom",
        "branch": "main",
        "prefix": "site/"
      },
      {
        "owner": "lyzlov",
        "repo": "Dom-studio",
        "branch": "main",
        "prefix": ""
      }
    ]
  },
  "media": {
    "folder": "_assets/media/",
    "widths": [
      400,
      800
    ],
    "quality": 82,
    "folders": [
      "courses",
      "events",
      "camp",
      "team",
      "space"
    ],
    "fallbackFolder": "space"
  },
  "theme": {
    "$comment": "Design groups and sections in the order they are shown. options names the section a reference value picks from. The words are in _lang/<language>/tokens.json.",
    "groups": [
      {
        "key": "color",
        "sections": [
          {
            "key": "palette",
            "pattern": "^--(mono|accent)-"
          },
          {
            "key": "applied",
            "pattern": "^--(role-|direction-|gradient-)",
            "options": "palette"
          }
        ]
      },
      {
        "key": "type",
        "sections": [
          {
            "key": "fonts",
            "pattern": "^--font-"
          },
          {
            "key": "styles",
            "pattern": "^--type-"
          },
          {
            "key": "measure",
            "pattern": "^--measure-"
          },
          {
            "key": "typesetting",
            "source": "typography"
          }
        ]
      },
      {
        "key": "layout",
        "sections": [
          {
            "key": "grid",
            "pattern": "^--(grid|gallery)-"
          },
          {
            "key": "spacing",
            "pattern": "^--space-"
          },
          {
            "key": "position",
            "pattern": "^--pos-"
          },
          {
            "key": "sizes",
            "pattern": "^--site-"
          },
          {
            "key": "layers",
            "pattern": "^--layer-"
          },
          {
            "key": "shapes",
            "pattern": "^--(line|radius|ratio)-"
          },
          {
            "key": "markup",
            "source": "markup",
            "dev": true
          }
        ]
      },
      {
        "key": "motion",
        "sections": [
          {
            "key": "motion",
            "pattern": "^--motion-"
          }
        ]
      }
    ],
    "conditions": {
      "(min-width: 600px)": "grid.tablet",
      "(min-width: 1024px)": "grid.desktop",
      "(prefers-reduced-motion: reduce)": "motion.reduced"
    },
    "typesetting": {
      "abbreviations": [
        "FAQ",
        "ID",
        "URL",
        "SVG",
        "CSS",
        "HTML",
        "SEO",
        "JSON",
        "UI"
      ]
    }
  },
  "layouts": {
    "$comment": "Page layouts with layers by structure: export and comparison.",
    "folder": "layouts/",
    "devices": [
      {
        "name": "mobile",
        "width": 390
      },
      {
        "name": "desktop",
        "width": 1440
      }
    ]
  }
}
