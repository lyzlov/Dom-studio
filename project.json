{
  "$комментарий": "Манифест проекта для редактора Enfilade: где лежат файлы, куда писать, как резать картинки, как сгруппированы токены. Имён проекта в коде редактора нет.",
  "name": "ДОМ",
  "contract": 1,
  "files": {
    "site": "_content/site.json",
    "archive": "_content/archive.json",
    "catalog": "_content/catalog/{name}.json",
    "texts": "_content/text/",
    "pages": "_structure/pages.json",
    "templates": "_structure/templates.json",
    "navigation": "_structure/navigation.json",
    "form": "_structure/form.json",
    "types": "_elements/types.json",
    "markup": "_elements/markup.html",
    "tokens": "_theme/tokens.css",
    "typography": "_theme/typography.json",
    "styles": "_theme/style.css"
  },
  "commit": {
    "$комментарий": "Куда уходит коммит. Приставка — путь до корня сайта внутри репозитория.",
    "targets": [
      {
        "owner": "lyzlov",
        "repo": "Dom",
        "branch": "main",
        "prefix": "site/"
      },
      {
        "owner": "lyzlov",
        "repo": "Dom-studio",
        "branch": "main",
        "prefix": ""
      }
    ],
    "message": "Правки из редактора"
  },
  "media": {
    "folder": "_content/media/",
    "widths": [
      400,
      800
    ],
    "quality": 82,
    "folders": [
      "courses",
      "events",
      "camp",
      "team",
      "space"
    ],
    "fallbackFolder": "space"
  },
  "theme": {
    "$комментарий": "Группы и разделы оформления в порядке вывода. options — раздел, из которого берутся варианты для значений-ссылок. Подписи — в _editor/locale.",
    "groups": [
      {
        "key": "color",
        "sections": [
          {
            "key": "palette",
            "pattern": "^--(mono|accent)-"
          },
          {
            "key": "applied",
            "pattern": "^--(role-|direction-|gradient-)",
            "options": "palette"
          }
        ]
      },
      {
        "key": "type",
        "sections": [
          {
            "key": "fonts",
            "pattern": "^--font-"
          },
          {
            "key": "styles",
            "pattern": "^--type-"
          },
          {
            "key": "measure",
            "pattern": "^--measure-"
          },
          {
            "key": "typesetting",
            "source": "typography"
          }
        ]
      },
      {
        "key": "layout",
        "sections": [
          {
            "key": "grid",
            "pattern": "^--(grid|gallery)-"
          },
          {
            "key": "spacing",
            "pattern": "^--space-"
          },
          {
            "key": "sizes",
            "pattern": "^--size-"
          },
          {
            "key": "markup",
            "source": "markup",
            "dev": true
          }
        ]
      },
      {
        "key": "motion",
        "sections": [
          {
            "key": "motion",
            "pattern": "^--motion-"
          }
        ]
      }
    ],
    "conditions": {
      "(min-width: 600px)": "grid.tablet",
      "(min-width: 1024px)": "grid.desktop",
      "(prefers-reduced-motion: reduce)": "motion.reduced"
    },
    "typesetting": {
      "abbreviations": [
        "FAQ",
        "ID",
        "URL",
        "SVG",
        "CSS",
        "HTML",
        "SEO",
        "JSON",
        "UI"
      ]
    },
    "names": {
      "$comment": "Имена оформления на языке проекта: токены, написания, разделы. Ключ↔значение. Английского списка нет — по-английски вещь называется так, как называется её ключ.",
      "ru": {
