{
  "$комментарий": "Правила типографики. Применяются при сборке к тексту страниц; разметка и атрибуты не затрагиваются. Неразрывный пробел пишется как &nbsp; — так он виден в исходнике.",
  "включено": true,
  "правила": [
    {
      "имя": "многоточие",
      "найти": "\\.\\.\\.",
      "заменить": "…"
    },
    {
      "имя": "кавычки-ёлочки",
      "найти": "\"([^\"\\n]+)\"",
      "заменить": "«$1»"
    },
    {
      "имя": "тире вместо дефиса между словами",
      "найти": " - ",
      "заменить": " — "
    },
    {
      "имя": "короткое тире в числовом диапазоне",
      "найти": "(\\d)[ ]*-[ ]*(\\d)",
      "заменить": "$1–$2"
    },
    {
      "имя": "неразрывный перед рублём",
      "найти": "(\\d)[ ]+₽",
      "заменить": "$1&nbsp;₽"
    },
    {
      "имя": "неразрывный внутри телефона",
      "найти": "(\\+7)[ ](\\d{3})[ ](\\d{3})[ ](\\d{2})[ ](\\d{2})",
      "заменить": "$1&nbsp;$2&nbsp;$3&nbsp;$4&nbsp;$5"
    },
    {
      "имя": "неразрывный перед единицей",
      "найти": "(\\d)[ ]+(лет|года|год|мин|ч|км|м)\\b",
      "заменить": "$1&nbsp;$2"
    },
    {
      "имя": "неразрывный после предлога",
      "найти": "(^|[ («])([вВсСкКуУоОиИаАяЯ]|[Нн]а|[Зз]а|[Пп]о|[Дд]о|[Оо]т|[Ии]з|[Нн]е|[Нн]о)[ ]",
      "заменить": "$1$2&nbsp;"
    },
    {
      "имя": "неразрывный перед тире",
      "найти": "[ ]+—",
      "заменить": "&nbsp;—"
    }
  ]
}