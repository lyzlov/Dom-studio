{
  "$комментарий": "Правила типографики. Применяются при сборке к тексту страниц; разметка и атрибуты не затрагиваются. Неразрывный пробел пишется как &nbsp; — так он виден в исходнике.",
  "enabled": true,
  "rules": [
    {
      "name": "Многоточие",
      "find": "\\.\\.\\.",
      "replace": "…"
    },
    {
      "name": "Кавычки-ёлочки",
      "find": "\"([^\"\\n]+)\"",
      "replace": "«$1»"
    },
    {
      "name": "Тире вместо дефиса между словами",
      "find": " - ",
      "replace": " — "
    },
    {
      "name": "Короткое тире в числовом диапазоне",
      "find": "(\\d)[ ]*-[ ]*(\\d)",
      "replace": "$1–$2"
    },
    {
      "name": "Неразрывный перед рублём",
      "find": "(\\d)[ ]+₽",
      "replace": "$1&nbsp;₽"
    },
    {
      "name": "Неразрывный внутри телефона",
      "find": "(\\+7)[ ](\\d{3})[ ](\\d{3})[ ](\\d{2})[ ](\\d{2})",
      "replace": "$1&nbsp;$2&nbsp;$3&nbsp;$4&nbsp;$5"
    },
    {
      "name": "Неразрывный перед единицей",
      "find": "(\\d)[ ]+(лет|года|год|мин|ч|км|м)\\b",
      "replace": "$1&nbsp;$2"
    },
    {
      "name": "Неразрывный после предлога",
      "find": "(^|[ («])([вВсСкКуУоОиИаАяЯ]|[Нн]а|[Зз]а|[Пп]о|[Дд]о|[Оо]т|[Ии]з|[Нн]е|[Нн]о)[ ]",
      "replace": "$1$2&nbsp;"
    },
    {
      "name": "Неразрывный перед тире",
      "find": "[ ]+—",
      "replace": "&nbsp;—"
    }
  ]
}
